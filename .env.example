# SMTP credentials used by the reservation and newsletter forms (lib/mailer.js).
# Copy this file to .env.local and fill in real values — .env.local is gitignored.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Optional overrides:
# MAIL_FROM defaults to SMTP_USER; MAIL_TO defaults to kingstowershotel@gmail.com.
# MAIL_FROM=you@example.com
# MAIL_TO=kingstowershotel@gmail.com

# expressPay Ghana (lib/expresspay.js) — the deposit payment on the
# reservation form. Get these from expressPay's integrations team; NEVER
# commit real values, only set them in your hosting platform's env settings.
EXPRESSPAY_MERCHANT_ID=your-merchant-id
EXPRESSPAY_API_KEY=your-api-key

# Leave unset (or omit) to use the live API. Set to "sandbox" to test
# against https://sandbox.expresspaygh.com instead — useful for local dev
# so you don't need to swap real credentials in and out.
# EXPRESSPAY_ENV=sandbox
