# SMTP credentials used by the reservation and newsletter forms (lib/mailer.js).
# Copy this file to .env.local and fill in real values — .env.local is gitignored.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Optional overrides:
# MAIL_FROM defaults to SMTP_USER; MAIL_TO defaults to kingstowershotel@gmail.com.
# MAIL_FROM=you@example.com
# MAIL_TO=kingstowershotel@gmail.com

# ExpressPay credentials used by the reservation payment flow.
EXPRESSPAY_MERCHANT_ID=your-expresspay-merchant-id
EXPRESSPAY_API_KEY=your-expresspay-api-key
EXPRESSPAY_ENVIRONMENT=sandbox

# Public base URL used for ExpressPay redirect-url and post-url callbacks.
# In production this should be your HTTPS site URL.
# APP_BASE_URL=https://www.example.com
